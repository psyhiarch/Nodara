
# Ignore the local Meson build environment directory
/builddir/
/build*/

# Ignore native subproject checkouts managed by Meson (.wrap files)
/subprojects/*
!/subprojects/*.wrap

# Ignore target directories generated by Cargo compilation passes
/target/

# If you use a custom Cargo target directory override, ignore it
/cargo-target/

# Cargo backup files
**/*.rs.bk

# JetBrains IDEs (CLion, IntelliJ, etc.)
.idea/
*.iml

# VS Code config folders (except tasks or launch rules if shared)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# System specific junk files
.DS_Store
Thumbs.db
*~
*.swp

# Failsafe rule to block compiled schemas slipping through
**/gschema.compiled
**/*.gresource
